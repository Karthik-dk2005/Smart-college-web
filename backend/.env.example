# Database Configuration
# SQLite for local development:
DATABASE_URL=sqlite:///./smart_department.db
# PostgreSQL for production deployment:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_department_db

# JWT Security
SECRET_KEY=smart_department_production_secret_key_jwt_2026_safe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Campus & Department Geofence Configuration
DEPARTMENT_LATITUDE=12.183700
DEPARTMENT_LONGITUDE=76.694200
DEPARTMENT_RADIUS_METERS=300
COLLEGE_LAT=12.183700
COLLEGE_LON=76.694200
ATTENDANCE_RADIUS_METERS=300
